  "cross_domain_evidence": {
    "principle": "Grammar evidence may be collected not only from explicit Tatabahasa exercises but also from Menulis and written Pemahaman responses when the error is observable and attribution is sufficiently clear.",
    "examples": [
      "Repeated affix errors in essays may update the relevant imbuhan diagnostic node.",
      "Repeated incomplete sentence structures in comprehension responses may support an ayat-structure weakness.",
      "A single typo should not automatically become a grammar weakness.",
      "Where handwriting/OCR is uncertain, mark evidence as uncertain rather than diagnosing the learner."
    ]
  },
  "diagnosis_rules": {
    "single_error": "record as evidence only",
    "repeated_same_micro_skill": "raise weakness confidence",
    "cross_task_repetition": "stronger evidence than repeated errors inside one exercise",
    "cross_domain_repetition": "may support persistent grammar weakness when the same rule is violated in grammar exercises and authentic writing",
    "careless_vs_knowledge": "do not classify as knowledge weakness solely from one isolated error when surrounding evidence shows correct use",
    "uncertain_recognition": "never convert uncertain OCR/marking recognition into a confirmed weakness"
  },
  "remediation_framework": {
    "sequence": ["recognise", "classify", "explain function or rule", "choose correct form", "correct error", "construct in context", "apply in authentic writing", "retest"],
    "mastery_gate": "Do not mark a grammar micro-skill mastered solely because the learner corrected one previously wrong item. Require later independent evidence."
  }
}

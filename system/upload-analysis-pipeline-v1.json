  "review_ui_rules":[
    "Show the original crop beside every uncertain extracted field.",
    "Allow one-click correction of OCR text, question number, teacher mark and score.",
    "Highlight only fields that materially affect diagnosis; do not force the user to verify every correctly read printed line.",
    "After teacher correction, persist corrected truth and recompute downstream diagnosis.",
    "Never hide the original OCR result so extraction quality can be audited."
  ],
  "diagnosis_gate":{"rule":"No confirmed weakness update from a question unless correctness and relevant response text are sufficiently reliable.","allowed_states":["verified","high_confidence_consistent"],"blocked_states":["uncertain_ocr","ambiguous_mark","missing_question_alignment"]},
  "auditability":{"store":["original page","cropped regions","raw OCR","corrected OCR","who corrected","timestamp","mapping version","diagnostic version"],"reason":"Any future model upgrade must allow reprocessing without losing historical truth."}
